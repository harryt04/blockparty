{
  "name": "blockparty",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @blockparty/web dev",
    "start": "pnpm --filter @blockparty/web start",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/game-content && tsc -p packages/game-engine && tsc -p apps/web",
    "format": "prettier --write .",
    "build": "pnpm --filter @blockparty/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "@next/eslint-plugin-next": "^15.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0"
  }
}
