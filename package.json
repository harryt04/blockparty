{
  "name": "blockparty",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/harryt04/blockparty.git"
  },
  "homepage": "https://github.com/harryt04/blockparty#readme",
  "bugs": {
    "url": "https://github.com/harryt04/blockparty/issues"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "ci": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local tools/run-dev.mjs",
    "agent:smoke": "tsx tools/live-agent-smoke.ts",
    "start": "pnpm --filter @blockparty/web start",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/game-content && tsc -p packages/game-engine && tsc -p apps/web && tsc -p tools/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "prettify": "prettier --write .",
    "build": "pnpm --filter @blockparty/web build",
    "test:browser": "playwright test",
    "perf:load": "tsx tools/load-harness.ts",
    "db:maintain": "pnpm --filter @blockparty/web db:maintain",
    "db:verify-restore": "pnpm --filter @blockparty/web db:verify-restore"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.37.0",
    "@next/eslint-plugin-next": "^15.5.4",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.9.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.0"
  }
}
