# Blockparty environment template.
# Copy to .env.local for development. Never commit a real secret.
# No secret may use a NEXT_PUBLIC_ prefix; those values reach the browser.

# --- Public URL and runtime ------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# --- MongoDB ---------------------------------------------------------------
# MongoDB is deployed separately. Transactions require a replica set, so the
# URI must point at a replica set, not a standalone server.
# Leave unset in development: the app boots and every page renders without it.
MONGODB_URI=""
MONGODB_DB="blockparty"

# --- Capabilities and sessions ---------------------------------------------
# 32+ random bytes, base64. Used to sign/verify capability cookies.
COOKIE_SECRET=""

# --- Origins and CSRF ------------------------------------------------------
# Comma-separated first-party origin allowlist. Never "*".
ALLOWED_ORIGINS="http://localhost:3000"

# --- Version identifiers ---------------------------------------------------
PROTOCOL_VERSION="1"
APP_VERSION="0.0.0"
CONTENT_VERSION="0.0.0-placeholder"
PWA_CACHE_VERSION="1"

# --- Internal operations ---------------------------------------------------
# Shared secret for the scheduled retention cleanup endpoint.
# Sent as the "x-internal-secret" header. Unset means the route is disabled.
INTERNAL_CLEANUP_SECRET=""

# --- Rate limits -----------------------------------------------------------
RATE_LIMIT_CREATE_PER_MINUTE="10"
RATE_LIMIT_JOIN_PER_MINUTE="30"
RATE_LIMIT_COMMANDS_PER_MINUTE="120"
RATE_LIMIT_SYNC_PER_MINUTE="60"
RATE_LIMIT_SSE_CONNECTIONS="8"

# --- Analytics (opt-in only, see ANA-001) ----------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
